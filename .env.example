# 宿主发布端口（仅前端应用服务发布到宿主）
CC_PUBLISH_PORT=3040

# compose 项目名（由环境固定，勿改）
COMPOSE_PROJECT_NAME=task2026-09-1240

# 数据库（仅 compose 内部网络使用，不发布到宿主）
POSTGRES_DB=assistdb
POSTGRES_USER=assist
POSTGRES_PASSWORD=assist123

# JWT 签名密钥（生产环境务必修改，长度 >= 32 字节）
JWT_SECRET=assist-platform-dev-secret-key-2026-09-change-me
